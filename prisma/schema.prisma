generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Order {
  id                  String       @id
  channel             String
  fulfillment         String
  sourceLabel         String?      @map("source_label")
  status              String
  arrivalStatus       String       @map("arrival_status")
  pickupCode          String?      @map("pickup_code")
  paidAt              DateTime     @map("paid_at") @db.Timestamptz(6)
  createdAt           DateTime     @map("created_at") @db.Timestamptz(6)
  startedAt           DateTime?    @map("started_at") @db.Timestamptz(6)
  readyAt             DateTime?    @map("ready_at") @db.Timestamptz(6)
  servedAt            DateTime?    @map("served_at") @db.Timestamptz(6)
  deliveredAt         DateTime?    @map("delivered_at") @db.Timestamptz(6)
  prepEstimateMinutes Int?         @map("prep_estimate_minutes")
  priorityFlag        Boolean?     @default(false) @map("priority_flag")
  audit               AuditEntry[]
  items               OrderItem[]

  @@index([channel], map: "idx_orders_channel")
  @@index([fulfillment], map: "idx_orders_fulfillment")
  @@index([status], map: "idx_orders_status")
  @@map("orders")
}

model OrderItem {
  id        Int     @id @default(autoincrement())
  orderId   String? @map("order_id")
  name      String?
  qty       Int?
  modifiers Json?
  allergies Json?
  station   String?
  notes     String?
  order     Order?  @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([orderId], map: "idx_order_items_order_id")
  @@map("order_items")
}

model AuditEntry {
  id      Int      @id @default(autoincrement())
  orderId String?  @map("order_id")
  ts      DateTime @db.Timestamptz(6)
  actor   String?
  action  String?
  details Json?
  order   Order?   @relation(fields: [orderId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([orderId], map: "idx_audit_order_id")
  @@map("audit")
}

model ProcessedEvent {
  eventId String  @id @map("event_id")
  source  String?

  @@map("processed_events")
}

model MenuItem {
  id           String    @id
  name         String
  description  String?
  price        Decimal?  @db.Decimal
  category     String?
  image        String?
  dietary      Json?     @default("[]")
  popular      Boolean?  @default(false)
  variations   Json?     @default("[]")
  optionGroups Json?     @default("[]") @map("option_groups")
  includes     Json?     @default("[]")
  notes        String?
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("menu_items")
}

model InventoryItem {
  itemId        String    @id @map("item_id")
  itemName      String    @map("item_name")
  currentStock  Int?      @map("current_stock")
  minStock      Int?      @map("min_stock")
  maxStock      Int?      @map("max_stock")
  unit          String?
  status        String?
  autoReorder   Boolean?  @map("auto_reorder")
  lastRestocked DateTime? @map("last_restocked") @db.Timestamptz(6)

  @@map("inventory")
}

model Setting {
  key       String    @id
  value     Json
  updatedAt DateTime? @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("settings")
}

model StaffUser {
  id           Int       @id @default(autoincrement())
  username     String    @unique
  passwordHash String    @map("password_hash")
  role         String
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("staff_users")
}

model Admin {
  id       Int    @id @default(autoincrement())
  username String @unique
  password String

  @@map("admin")
}

model Session {
  token     String @id
  createdAt BigInt @map("created_at")
  expiresAt BigInt @map("expires_at")

  @@map("sessions")
}

model Reservation {
  id              String  @id
  name            String
  email           String
  phone           String
  guests          String
  date            String
  time            String
  specialRequests String? @map("special_requests")
  status          String?
  notes           String?
  createdAt       BigInt  @map("created_at")

  @@map("reservations")
}

model CustomerReview {
  id         String        @id
  name       String?
  email      String?
  rating     Int?
  review     String?
  occasion   String?
  date       String?
  approved   Boolean?
  visible    Boolean?
  adminNotes String?       @map("admin_notes")
  createdAt  BigInt?       @map("created_at")
  replies    ReviewReply[]

  @@map("customer_reviews")
}

model ReviewReply {
  id         String          @id
  reviewId   String?         @map("review_id")
  senderType String?         @map("sender_type")
  senderName String?         @map("sender_name")
  message    String?
  isRead     Boolean?        @map("is_read")
  createdAt  BigInt?         @map("created_at")
  review     CustomerReview? @relation(fields: [reviewId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("review_replies")
}

model ReviewAccessToken {
  email           String    @id
  accessToken     String    @map("access_token")
  expiresAt       DateTime  @map("expires_at") @db.Timestamptz(6)
  createdAt       DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  lastRequestedAt DateTime? @default(now()) @map("last_requested_at") @db.Timestamptz(6)

  @@map("review_access_tokens")
}

model Promotion {
  id                   String   @id
  name                 String?
  description          String?
  type                 String?
  value                Decimal? @db.Decimal
  applicableItems      Json?    @default("[]") @map("applicable_items")
  applicableCategories Json?    @default("[]") @map("applicable_categories")
  startDate            String?  @map("start_date")
  endDate              String?  @map("end_date")
  active               Boolean?
  code                 String?
  minimumPurchase      Decimal? @map("minimum_purchase") @db.Decimal
  maxUses              Int?     @map("max_uses")
  currentUses          Int?     @map("current_uses")
  daysOfWeek           Json?    @default("[]") @map("days_of_week")
  timeStart            String?  @map("time_start")
  timeEnd              String?  @map("time_end")
  createdAt            BigInt?  @map("created_at")

  @@map("promotions")
}

model GroupOrder {
  id            String           @id
  initiatorName String?          @map("initiator_name")
  status        String?
  createdAt     BigInt?          @map("created_at")
  expiresAt     BigInt?          @map("expires_at")
  items         GroupOrderItem[]

  @@map("group_orders")
}

model GroupOrderItem {
  id                  String      @id
  groupOrderId        String?     @map("group_order_id")
  participantName     String?     @map("participant_name")
  menuItemId          String?     @map("menu_item_id")
  menuItemName        String?     @map("menu_item_name")
  menuItemPrice       Decimal?    @map("menu_item_price") @db.Decimal
  menuItemImage       String?     @map("menu_item_image")
  quantity            Int?
  selectedVariation   Json?       @map("selected_variation")
  selectedOptions     Json?       @map("selected_options")
  specialInstructions String?     @map("special_instructions")
  createdAt           BigInt?     @map("created_at")
  groupOrder          GroupOrder? @relation(fields: [groupOrderId], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("group_order_items")
}

model LegacyOrder {
  id            String    @id
  items         Json?
  total         Decimal?  @db.Decimal
  status        String?
  customerName  String?   @map("customer_name")
  customerPhone String?   @map("customer_phone")
  estimatedTime Int?      @map("estimated_time")
  timestamp     BigInt?
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("legacy_orders")
}

model PaymentLink {
  orderId       String    @id @map("order_id")
  userId        String?   @map("user_id")
  amount        Decimal?  @db.Decimal
  state         String?
  paymentLink   String?   @map("payment_link")
  fulfillment   String?
  channel       String?
  items         Json?
  customerName  String?   @map("customer_name")
  customerPhone String?   @map("customer_phone")
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime? @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("payment_links")
}

model Location {
  id           String   @id
  name         String
  phone        String
  addressLine1 String   @map("address_line1")
  addressLine2 String?  @map("address_line2")
  city         String
  state        String
  postalCode   String   @map("postal_code")
  country      String
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime? @default(now()) @map("updated_at") @db.Timestamptz(6)

  deliveryQuotes    DeliveryQuote[]
  deliveryAddresses DeliveryAddress[]

  @@map("locations")
}

model DeliveryAddress {
  orderId      String   @id @map("order_id")
  locationId   String   @map("location_id")
  name         String?
  phone        String?
  addressLine1 String   @map("address_line1")
  addressLine2 String?  @map("address_line2")
  city         String
  state        String
  postalCode   String   @map("postal_code")
  country      String
  instructions String?
  createdAt    DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime? @default(now()) @map("updated_at") @db.Timestamptz(6)

  location Location @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@map("delivery_addresses")
}

model DeliveryQuote {
  orderId    String   @id @map("order_id")
  provider   String
  locationId String   @map("location_id")
  quoteId    String   @map("quote_id")
  feeCents   Int      @map("fee_cents")
  currency   String
  eta        String?
  expiresAt  DateTime? @map("expires_at") @db.Timestamptz(6)
  raw        Json?
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime? @default(now()) @map("updated_at") @db.Timestamptz(6)

  location Location @relation(fields: [locationId], references: [id], onDelete: Restrict)

  @@map("delivery_quotes")
}

model DeliveryRequest {
  orderId    String    @id @map("order_id")
  provider   String?
  deliveryId String?   @map("delivery_id")
  status     String?
  eta        String?
  updatedAt  DateTime? @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@map("delivery_requests")
}

model TabletSession {
  tabletId              String    @id @map("tablet_id")
  sessionId             String    @map("session_id")
  questionCount         Int       @default(0) @map("question_count")
  lastActivityTimestamp DateTime  @map("last_activity_timestamp") @db.Timestamptz(6)
  orderStatus           String    @default("NONE") @map("order_status")
  warningSent           Boolean   @default(false) @map("warning_sent")
  agentConversationId   String?   @map("agent_conversation_id")
  conversationHistory   Json?     @default("[]") @map("conversation_history")
  createdAt             DateTime? @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime? @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@index([lastActivityTimestamp], map: "idx_tablet_sessions_last_activity")
  @@map("tablet_sessions")
}
